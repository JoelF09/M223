    "CREATE TABLE IF NOT EXISTS \"account\" (\n  \"benutzername\" TEXT NOT NULL UNIQUE,\n  \"passwort\" TEXT NOT NULL,\n  \"name\" TEXT NOT NULL,\n  \"station\" TEXT,\n  \"gruppe\" TEXT NOT NULL CHECK (\"gruppe\" IN ('mitarbeiter', 'admin')),\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT\n)",
    "CREATE UNIQUE INDEX IF NOT EXISTS \"account_benutzername_uidx\" ON \"account\" (\"benutzername\")",
    "CREATE TABLE IF NOT EXISTS \"kunde\" (\n  \"vorname\" TEXT NOT NULL,\n  \"nachname\" TEXT NOT NULL,\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"version\" INTEGER DEFAULT 1\n)",
    "CREATE TABLE IF NOT EXISTS \"auto\" (\n  \"marke\" TEXT NOT NULL,\n  \"modell\" TEXT NOT NULL,\n  \"kennzeichen\" TEXT NOT NULL UNIQUE,\n  \"status\" TEXT DEFAULT 'verfuegbar' CHECK (\"status\" IN ('verfuegbar', 'defekt')),\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT\n)",
    "CREATE UNIQUE INDEX IF NOT EXISTS \"auto_kennzeichen_uidx\" ON \"auto\" (\"kennzeichen\")",
    "CREATE INDEX IF NOT EXISTS \"auto_status_idx\" ON \"auto\" (\"status\")",
    "CREATE TABLE IF NOT EXISTS \"vermietung\" (\n  \"auto_id\" INTEGER NOT NULL REFERENCES \"auto\"(\"id\"),\n  \"kunde_id\" INTEGER NOT NULL REFERENCES \"kunde\"(\"id\"),\n  \"ausgeliehen_am\" TEXT NOT NULL,\n  \"zurueckgegeben_am\" TEXT,\n  \"status\" TEXT DEFAULT 'offen' CHECK (\"status\" IN ('offen', 'abgeschlossen', 'unfall')),\n  \"created_at\" TEXT,\n  \"updated_at\" TEXT,\n  \"created_by\" INTEGER REFERENCES \"account\"(\"id\"),\n  \"updated_by\" INTEGER REFERENCES \"account\"(\"id\"),\n  \"gesperrt_von\" INTEGER REFERENCES \"account\"(\"id\"),\n  \"gesperrt_am\" TEXT,\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"version\" INTEGER DEFAULT 1\n)",
    "CREATE INDEX IF NOT EXISTS \"vermietung_created_by_idx\" ON \"vermietung\" (\"created_by\")",
    "CREATE INDEX IF NOT EXISTS \"vermietung_updated_by_idx\" ON \"vermietung\" (\"updated_by\")",
    "CREATE INDEX IF NOT EXISTS \"vermietung_gesperrt_von_idx\" ON \"vermietung\" (\"gesperrt_von\")",
    "CREATE UNIQUE INDEX IF NOT EXISTS \"auto_nur_einmal_offen\" ON \"vermietung\" (\"auto_id\") WHERE \"zurueckgegeben_am\" IS NULL",
    "CREATE TABLE IF NOT EXISTS \"protokoll\" (\n  \"tabelle\" TEXT NOT NULL,\n  \"datensatz_id\" TEXT NOT NULL,\n  \"aktion\" TEXT NOT NULL,\n  \"account_id\" INTEGER NOT NULL REFERENCES \"account\"(\"id\"),\n  \"zeitpunkt\" TEXT NOT NULL,\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT\n)"
  ],
